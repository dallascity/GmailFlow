{
  "name": "gmailflow",
  "productName": "GmailFlow",
  "version": "1.0.0",
  "description": "Gmail hesabınızla kişiselleştirilmiş, tek tek e-posta gönderimi",
  "author": "GmailFlow",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:web": "concurrently -k -n api,web -c blue,green \"node --watch-path=server server/standalone.js\" \"vite --host\"",
    "dev:electron": "concurrently -k -n web,app -c green,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 GMAILFLOW_PORT=3000 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "icon": "electron scripts/icon-from-svg.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.11",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.4",
    "html-to-text": "^10.0.1",
    "iconv-lite": "^0.7.3",
    "nodemailer": "^10.6.0",
    "papaparse": "^5.7.1"
  },
  "devDependencies": {
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/vue-3": "^3.34.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "pinia": "^4.1.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1",
    "wait-on": "^9.5.1"
  }
}
